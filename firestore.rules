rules_version = '2';
service cloud.firestore {
  match /databases/{db}/documents {
    function signedIn() { return request.auth != null && request.auth.token.email_verified == true; }
    function me() { return request.auth.token.email.lower(); }
    function isAdmin() { return signedIn() && exists(/databases/$(db)/documents/admins/$(me())); }
    function isTrainer(email) {
      return signedIn() && me() == email
        && get(/databases/$(db)/documents/trainers/$(email)).data.active == true;
    }
    function isClient(trainer, cid) {
      return signedIn()
        && exists(/databases/$(db)/documents/clientAccess/$(me()))
        && get(/databases/$(db)/documents/clientAccess/$(me())).data.trainer == trainer
        && get(/databases/$(db)/documents/clientAccess/$(me())).data.cid == cid;
    }
    // Free-trial sign-ups: open only while the trainer has switched them on (signup/config).
    function signupOpen(t) {
      return signedIn()
        && exists(/databases/$(db)/documents/signup/config)
        && get(/databases/$(db)/documents/signup/config).data.trainer == t
        && get(/databases/$(db)/documents/signup/config).data.enabled == true;
    }
    function selfAccessOk(email) {
      return me() == email
        && signupOpen(request.resource.data.trainer)
        && request.resource.data.cid == me()
        && request.resource.data.level == 1
        && request.resource.data.keys().hasOnly(['trainer', 'cid', 'name', 'level', 'split', 'days'])
        && exists(/databases/$(db)/documents/trainers/$(request.resource.data.trainer)/clients/$(me()));
    }
    function changed() { return request.resource.data.diff(resource.data).affectedKeys(); }
    match /admins/{email} {
      allow read: if signedIn() && me() == email;
      allow write: if false;
    }
    match /trainers/{email} {
      allow read: if isAdmin() || (signedIn() && me() == email);
      allow write: if isAdmin();
      match /clients/{cid} {
        allow read, write: if isAdmin() || isTrainer(email);
        // A new person signing in with Google can create ONE record for themselves (the document id is their email)
        // as a level-1 trial client. The trial start time must be the server time, so it cannot be faked.
        allow create: if signedIn() && cid == me() && signupOpen(email)
          && request.resource.data.keys().hasOnly(['name', 'level', 'email', 'split', 'revoked', 'entries', 'body', 'trialAt'])
          && request.resource.data.email == me()
          && request.resource.data.level == 1
          && request.resource.data.trialAt == request.time
          && request.resource.data.name is string && request.resource.data.name.size() <= 80;

        // A client can read their own record and change only their workout logs, their own WhatsApp number,
        // last-login time, workout days, custom plan and workout times. Each field is checked only when
        // that client changes it, so values the trainer wrote earlier never block the client.
        allow read: if isClient(email, cid);
        allow update: if isClient(email, cid)
          && changed().hasOnly(['entries', 'body', 'lastMsg', 'whatsapp', 'lastLogin', 'days', 'daysBy', 'daysAt', 'custom', 'customBy', 'customAt', 'sessions'])
          && (!changed().hasAny(['whatsapp']) || (request.resource.data.whatsapp is string && request.resource.data.whatsapp.size() <= 20))
          && (!changed().hasAny(['lastLogin']) || (request.resource.data.lastLogin is string && request.resource.data.lastLogin.size() <= 40))
          && (!changed().hasAny(['days']) || (request.resource.data.days is string && request.resource.data.days.size() <= 7))
          && (!changed().hasAny(['daysBy']) || request.resource.data.daysBy == 'client')
          && (!changed().hasAny(['daysAt']) || (request.resource.data.daysAt is string && request.resource.data.daysAt.size() <= 40))
          && (!changed().hasAny(['custom']) || (request.resource.data.custom is string && request.resource.data.custom.size() <= 200))
          && (!changed().hasAny(['customBy']) || request.resource.data.customBy == 'client')
          && (!changed().hasAny(['customAt']) || (request.resource.data.customAt is string && request.resource.data.customAt.size() <= 40))
          && (!changed().hasAny(['sessions']) || (request.resource.data.sessions is list && request.resource.data.sessions.size() <= 60));

        // Chat between a trainer and one client. Each message says who sent it.
        match /messages/{mid} {
          allow read: if isAdmin() || isTrainer(email) || isClient(email, cid);
          allow create: if (isAdmin() || isTrainer(email) || isClient(email, cid))
            && request.resource.data.keys().hasOnly(['from', 'text', 'at'])
            && request.resource.data.text is string
            && request.resource.data.text.size() > 0
            && request.resource.data.text.size() <= 1000
            && request.resource.data.at is string
            && request.resource.data.from == ((isAdmin() || isTrainer(email)) ? 'trainer' : 'client');
          allow delete: if isAdmin() || isTrainer(email);
        }
      }
      // The trainer's own diet chart library. Clients never read this: published charts are copied onto each client's record.
      match /diets/{id} {
        allow read, write: if isAdmin() || isTrainer(email);
      }
    }

    // Trial sign-up settings (which trainer, on/off, coach WhatsApp). Any signed-in user can read; only that trainer can change.
    match /signup/{id} {
      allow read: if signedIn();
      allow create, update: if isAdmin() || (signedIn() && isTrainer(me())
                     && request.resource.data.trainer == me()
                     && (resource == null || resource.data.trainer == me()));
    }

    // One small record per client login: which trainer they belong to and their level.
    match /clientAccess/{email} {
      allow read: if signedIn() && (me() == email || isAdmin()
                     || (resource != null && resource.data.trainer == me()));
      allow create: if signedIn() && (isAdmin()
                     || (request.resource.data.trainer == me() && isTrainer(me()))
                     || selfAccessOk(email));
      allow update: if signedIn() && (isAdmin()
                     || (resource.data.trainer == me() && request.resource.data.trainer == me() && isTrainer(me())));
      allow delete: if signedIn() && (isAdmin()
                     || (resource.data.trainer == me() && isTrainer(me())));
    }
  }
}
